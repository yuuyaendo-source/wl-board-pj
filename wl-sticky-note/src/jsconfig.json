{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/*": [
        "./shared/*",
        "../shared/*",
        "../../shared/*"
      ]
    }
  },
  "include": [
    "**/*",
    "shared/**/*",
    "../shared/**/*",
    "../../shared/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}