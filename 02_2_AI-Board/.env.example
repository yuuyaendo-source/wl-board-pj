# Google AI Studio で取得した API キーを設定してください（必須）
GEMINI_API_KEY=your_gemini_api_key_here
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=3

# 付箋検知カメラ: 未設定なら 0 (Webカメラ)。RTSP の例（認証情報は本番用に別途設定）:
# RTSP_URL=rtsp://user:pass@192.168.x.x:554/live/high
RTSP_URL=

# 付箋検知の最小面積 (ピクセル)。未設定なら解像度に応じて自動調整（4K など高解像度でノイズ除去用）
# MIN_AREA=2000

# 付箋ボード連携先（付箋検知・Webアプリからの送信先）
# 開発（このPC）: 未設定 or http://127.0.0.1:3000
# 開発（CATO経由・他PCから開発PCの付箋ボードへ）: http://172.16.1.251:3000
# 本番: http://wl-sticky-note.local（config.json の board_id は wl）
# POSTIT_BOARD_URL=http://172.16.1.251:3000
POSTIT_BOARD_URL=
