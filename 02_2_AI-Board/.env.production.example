# 本番用環境変数サンプル（コピーして .env にリネームし、値を設定）
# 付箋ボード連携: http://wl-sticky-note.local/board/wl

GEMINI_API_KEY=your_gemini_api_key_here
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=21

# 付箋検知カメラ（本番でRTSPの場合のみ設定）
# RTSP_URL=rtsp://user:pass@192.168.x.x:554/live/high
RTSP_URL=

# 付箋検知の最小面積（未設定なら自動調整）
# MIN_AREA=2000

# 本番: 付箋ボード連携先（必須）
POSTIT_BOARD_URL=http://wl-sticky-note.local
