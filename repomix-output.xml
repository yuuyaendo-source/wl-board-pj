              </li>
              <li role="none" className="border-t border-[var(--border)]">
                <button
                  type="button"
                  role="menuitem"
                  className="flex w-full items-center justify-between px-4 py-2.5 text-left text-sm text-zinc-700 hover:bg-zinc-100"
