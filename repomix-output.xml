    # この経路はロック取得しない (中継プロセスなので)。新インスタンスがロックを取る。
    for i, arg in enumerate(sys.argv):
        if arg == "--after-update-wait" and i + 1 < len(sys.argv):
            try:
                pid = int(sys.argv[i + 1])
                _wait_for_process_exit(pid)
