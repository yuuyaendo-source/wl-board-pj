│   └── AI-Board・Desktopアプリの開発の進め方.md
└── src/                # アプリ本体
    ├── app/            # Next.js App Router（画面）
    ├── components/     # React コンポーネント
    ├── server.js       # Express + Socket.IO サーバー
    ├── boards.json     # ボードデータ（自動作成）
    ├── package.json
    ├── deploy.sh       # 本番デプロイ用スクリプト
    └── README.md       # 開発・デプロイの詳細
```

