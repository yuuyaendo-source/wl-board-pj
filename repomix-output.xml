                  className="w-full px-4 py-2.5 text-left text-sm text-zinc-700 hover:bg-zinc-100"
                  onClick={() => {
                    setUserPanelOpen(true);
                    setAdminMenuOpen(false);
                    setSystemSubOpen(false);
