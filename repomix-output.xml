    except Exception:
        pass


def _wait_for_process_exit(pid: int):
    """指定 PID のプロセスが終了するまで待つ（Windows: OpenProcess + WaitForSingleObject）。"""
    if sys.platform == "win32":
        try:
            import ctypes
            kernel32 = ctypes.windll.kernel32  # type: ignore
            SYNCHRONIZE = 0x00100000
            INFINITE = 0xFFFFFFFF
            handle = kernel32.OpenProcess(SYNCHRONIZE, False, pid)
            if handle:
                try:
                    kernel32.WaitForSingleObject(handle, INFINITE)
                finally:
                    kernel32.CloseHandle(handle)
        except Exception:
            import time
            while True:
                try:
                    os.kill(pid, 0)
                except (OSError, ProcessLookupError):
                    break
                time.sleep(0.5)
    else:
        import time
        while True:
            try:
                os.kill(pid, 0)
            except (OSError, ProcessLookupError):
                break
            time.sleep(0.5)


def _launch_self():
    """自分自身（exe または python app.py）を新プロセスで起動する。"""
    exe = sys.executable
    if getattr(sys, "frozen", False):
        flags = 0
        if sys.platform == "win32":
            flags = getattr(subprocess, "CREATE_NO_WINDOW", 0x08000000)
        subprocess.Popen([exe], creationflags=flags)
    else:
        args = [a for a in sys.argv[1:] if not a.startswith("--after-update-wait")]
