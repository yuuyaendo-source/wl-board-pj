# 本番サーバ用 Nginx 設定（staging なし）
# staging.conf で nginx -t が失敗する場合に使用。
#   sudo cp .../nginx.conf.production-server-no-staging /etc/nginx/nginx.conf
#   sudo nginx -t && sudo systemctl restart nginx
# 証明書: Let's Encrypt *.internal.wonder-link.co.jp を /home/devuser01/sv_cert/ に配置

worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    include /etc/nginx/conf.d/active_env.conf;

    server {
        listen 80;
        server_name wlboardsys.internal.wonder-link.co.jp 172.16.1.203;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name wlboardsys.internal.wonder-link.co.jp 172.16.1.203;

        ssl_certificate     /home/devuser01/sv_cert/fullchain.pem;
        ssl_certificate_key /home/devuser01/sv_cert/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

        location /socket.io/ {
            proxy_pass http://current_sticky;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /board/ {
            proxy_pass http://current_sticky;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/boards/ {
            proxy_pass http://current_sticky/api/boards/;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/sticky_notes {
            proxy_pass http://current_sticky/api/sticky_notes;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/health {
            proxy_pass http://current_sticky/api/health;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/bs/ {
            proxy_pass http://current_backend/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /boards/ {
            proxy_pass http://current_frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = / {
            return 302 https://$host/boards/taskboard;
        }

        location / {
            return 302 https://$host/boards/taskboard;
        }
    }
}
