# 本番サーバ用 Nginx 設定（wl-board-sys-sv / devuser01）
# 使い方: サーバで以下を実行
#   sudo cp /var/www/wlinko-pj/board-system/nginx/nginx.conf.production-server /etc/nginx/nginx.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# FQDN: wl-ai-board.internal.wonder-link.co.jp / IP: 172.16.1.84
# 証明書: /home/devuser01/sv_cert/ （本番サーバの実際のパス）
# staging.conf も include する（ステージング環境を使う場合）

worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    include /etc/nginx/conf.d/active_env.conf;
    include /etc/nginx/conf.d/staging.conf;

    # HTTP → HTTPS リダイレクト
    server {
        listen 80;
        server_name wl-ai-board.internal.wonder-link.co.jp 172.16.1.84;
        return 301 https://$host$request_uri;
    }

    # HTTPS（本番: /home/devuser01/sv_cert）
    server {
        listen 443 ssl;
        server_name wl-ai-board.internal.wonder-link.co.jp 172.16.1.84;

        ssl_certificate     /home/devuser01/sv_cert/fullchain.pem;
        ssl_certificate_key /home/devuser01/sv_cert/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

        # ----------------------------------------------------
        # 1. Sticky Note (Express + Socket.IO) へのルーティング
        # ----------------------------------------------------
        location /socket.io/ {
            proxy_pass http://current_sticky;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /board/ {
            proxy_pass http://current_sticky;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/boards/ {
            proxy_pass http://current_sticky/api/boards/;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/sticky_notes {
            proxy_pass http://current_sticky/api/sticky_notes;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/health {
            proxy_pass http://current_sticky/api/health;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ----------------------------------------------------
        # 2. Board System Backend (FastAPI) へのルーティング
        # ----------------------------------------------------
        location /api/bs/ {
            rewrite ^/api/bs/(.*)$ /$1 break;
            proxy_pass http://current_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ----------------------------------------------------
        # 3. Board System Frontend (Next.js) へのルーティング
        # ----------------------------------------------------
        location /boards/ {
            proxy_pass http://current_frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = / {
            return 302 https://$host/boards/taskboard;
        }

        location / {
            return 302 https://$host/boards/taskboard;
        }
    }
}
