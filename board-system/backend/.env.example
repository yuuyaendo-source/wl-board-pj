# Board System Backend - 環境変数例
# コピーして .env にリネームし、値を設定

# DB: 開発は SQLite (async)。本番は PostgreSQL の場合: postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./board.db

# ローカル LLM（Ollama）。自動仕分け・マトリクススコア・日次リセットに使用。未設定なら AI はスキップ
OLLAMA_URL=http://172.16.1.251:11434/v1
# OLLAMA_MODEL=llama3.2

# ※ Gemini は使用しない（ローカル LLM 利用のためコメントアウト）
# GEMINI_API_KEY=your_key_from_google_ai_studio
# GEMINI_MODEL=gemini-2.0-flash

# 付箋ボード（02_1）のベースURL。タスクゴミ箱から削除時に 02_1 へ DELETE 連携。未設定時は http://127.0.0.1:3000
# POSTIT_BOARD_URL=http://127.0.0.1:3000

# Google カレンダー連携（パーソナルボードの「今日の予定」）。未設定ならカレンダー連携は無効
# Google Cloud Console で OAuth 2.0 クライアント ID（ウェブアプリ）を作成し、リダイレクト URI を登録
# GOOGLE_CALENDAR_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=xxx
# GOOGLE_CALENDAR_REDIRECT_URI=https://wl-ai-board.example.com/auth/google/callback
# カレンダー「今日」のタイムゾーン（その日 0:00〜23:59 の取得に使用）。未設定時は Asia/Tokyo
# CALENDAR_TIMEZONE=Asia/Tokyo

# 任意: ログレベル (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
