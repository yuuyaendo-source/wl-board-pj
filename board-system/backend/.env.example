# Board System Backend - 環境変数例
# コピーして .env にリネームし、値を設定

# DB: 開発は SQLite (async)。本番は PostgreSQL の場合: postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./board.db

# ローカル LLM（Ollama）。自動仕分け・マトリクススコア・日次リセットに使用。未設定なら AI はスキップ
OLLAMA_URL=http://172.16.1.242:11435/v1
# 省略時は Ollama の /api/tags（modified_at が新しいモデル）→ だめなら /v1/models で自動解決
# OLLAMA_MODEL=pakachan/elyza-llama3-8b:latest
# OLLAMA_MODEL_AUTO_CACHE_TTL_SECONDS=600
#
# 社内 LLM Docker を3台まで切替: LLM_TARGET=1|2|3（未設定なら上記のみ使用）
# OLLAMA_URL_n が空のときは OLLAMA_URL に、OLLAMA_MODEL_n が空のときは OLLAMA_MODEL にフォールバック
# LLM_TARGET=1
# OLLAMA_URL_1=http://172.16.1.251:11434/v1
# OLLAMA_MODEL_1=pakachan/elyza-llama3-8b:latest
# OLLAMA_URL_2=http://172.16.1.252:11434/v1
# OLLAMA_MODEL_2=
# OLLAMA_URL_3=http://172.16.1.253:11434/v1
# OLLAMA_MODEL_3=

# ※ Gemini は使用しない（ローカル LLM 利用のためコメントアウト）
# GEMINI_API_KEY=your_key_from_google_ai_studio
# GEMINI_MODEL=gemini-2.0-flash

# 付箋ボード（02_1）のベースURL。タスクゴミ箱から削除時に 02_1 へ DELETE 連携。未設定時は http://127.0.0.1:3000
POSTIT_BOARD_URL=http://127.0.0.1:3000

# Google カレンダー連携（パーソナルボードの「今日の予定」）。未設定ならカレンダー連携は無効
# Google Cloud Console で OAuth 2.0 クライアント ID（ウェブアプリ）を作成し、リダイレクト URI を登録
# GOOGLE_CALENDAR_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=xxx
# GOOGLE_CALENDAR_REDIRECT_URI=https://wlboardsys.example.com/auth/google/callback
# カレンダー「今日」のタイムゾーン（その日 0:00〜23:59 の取得に使用）。未設定時は Asia/Tokyo
CALENDAR_TIMEZONE=Asia/Tokyo

# 日次スケジュール（日本時間 Asia/Tokyo）。8:00 run_8am、10:00 ニュースクリア、10:15 sync_to_morning + ニュース取得
# 無効にする場合: SCHEDULER_ENABLED=false
SCHEDULER_ENABLED=true
# 自サーバの URL（スケジューラが POST する先）。Docker 内では http://127.0.0.1:8000 で可
SCHEDULER_BASE_URL=http://127.0.0.1:8000
# テスト用: ニュース取得を N 分ごとに実行（0 または未設定で無効）。例: 3 で 3 分ごと
SCHEDULER_NEWS_INTERVAL_MINUTES=3

# 任意: ログレベル (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# OAuth トークン暗号化キー（本番環境では必ず32バイト以上の安全なキーを設定）
# 本番用:
# TOKEN_ENCRYPTION_KEY=s3cr3t-k3y-f0r-3ncrypt1ng-t0k3ns-32-b4yts!
# 開発用（またはテスト時のみ）:
TOKEN_ENCRYPTION_KEY=YourSuperSecretKeyMustBe32Bytes!
