# Board System Backend - 本番用環境変数例
# コピーして .env にリネームし、サーバで使用

DATABASE_URL=sqlite+aiosqlite:///./board.db
# 付箋ボードのベースURL（タスクゴミ箱から削除時に付箋ボードへ DELETE 連携）
# 同一サーバなら 127.0.0.1、ドメインでも可
POSTIT_BOARD_URL=http://wl-sticky-note.local
# POSTIT_BOARD_URL=http://127.0.0.1:3000

# 任意: Gemini（自動仕分け・マトリクス・日次リセット）
# GEMINI_API_KEY=your_key
# LOG_LEVEL=INFO
