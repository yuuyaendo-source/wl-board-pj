# Board System Backend - 本番用環境変数例
# コピーして .env にリネームし、サーバで使用

DATABASE_URL=sqlite+aiosqlite:///./board.db
# 付箋ボードのベースURL（タスクゴミ箱から削除時に付箋ボードへ DELETE 連携）
# 同一サーバなら 127.0.0.1、FQDN は wlboardsys.internal.wonder-link.com
POSTIT_BOARD_URL=https://wlboardsys.internal.wonder-link.com
# POSTIT_BOARD_URL=http://127.0.0.1:3000

# ローカル LLM（Ollama）。自動仕分け・マトリクス・日次リセットに使用
OLLAMA_URL=http://172.16.1.242:11435/v1
# OLLAMA_MODEL は省略可（自動解決）
#
# 社内 LLM Docker を3台切替: LLM_TARGET=1|2|3 と OLLAMA_URL_1..3 / OLLAMA_MODEL_1..3（詳細は backend/.env.example）
# LLM_TARGET=1

# ※ Gemini は使用しない（コメントアウト）
# GEMINI_API_KEY=your_key
# LOG_LEVEL=INFO
