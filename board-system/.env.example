# .env ファイルコピー用テンプレート
# 本番: cp .env.example .env のうえで値を設定し、deploy.sh 実行時に読み込まれる

# ローカル LLM（Ollama）。自動仕分け・マトリクススコア・日次リセットに使用。未設定時は AI はスキップ
OLLAMA_URL=http://172.16.1.251:11434/v1
# OLLAMA_MODEL=llama3.2

# フロントビルド時に埋め込む API・付箋ボード URL（本番では https にすること）
# 未設定時は docker-compose.prod.yml のデフォルト（wl-ai-board.internal.wonder-link.co.jp）が使われる
# NEXT_PUBLIC_API_URL=https://wl-ai-board.internal.wonder-link.co.jp/api/bs
# NEXT_PUBLIC_LEGACY_BOARD_URL=https://wl-ai-board.internal.wonder-link.co.jp

# 任意: ログレベル
# LOG_LEVEL=INFO

# Google カレンダー連携（パーソナルボードの「今日の予定」）。未設定なら連携無効
# Google Cloud Console で OAuth 2.0 クライアント ID（ウェブアプリ）を作成し、リダイレクト URI を登録してから設定
# GOOGLE_CALENDAR_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=xxx
# GOOGLE_CALENDAR_REDIRECT_URI=https://wl-ai-board.internal.wonder-link.co.jp/api/bs/auth/google/callback
# OAuth 成功後にパーソナルボードへ戻すパス。本番で Next basePath が /boards のときは /boards（未設定時は compose で /boards をデフォルト指定）
# OAUTH_SUCCESS_REDIRECT_BASE=/boards

# ※ DB は docker-compose.db.yml で定義。DATABASE_URL は backend コンテナ内で compose が指定するためここでは不要。
# ※ Gemini は使用しない（ローカル LLM 利用のため）。
