# .env ファイルコピー用テンプレート
# 本番: .env にリネームして値を設定

# DB接続設定（backendコンテナから見た接続先）
# docker-compose.db.yml で定義したサービス名 'linko-db' (linko-net内) に接続
DATABASE_URL=postgresql+asyncpg://linko_user:linko_password@linko-db:5432/linko_board_system

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ログ設定
LOG_LEVEL=INFO

# CATO証明書パス（Dockerfile内で設定済みだが、変更したい場合）
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
