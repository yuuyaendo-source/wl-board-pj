<file path="docker-compose.prod.yml">
# version は obsolete のため省略（Compose V2）

services:
  backend:
    build: ./backend
    container_name: linko-backend-${COLOR}
    ports:
      - "127.0.0.1:${PORT_BACKEND}:8000"
    environment:
      # DBは linko-db (docker-compose.db.ymlで定義) に接続
      DATABASE_URL: postgresql+asyncpg://linko_user:linko_password@linko-db:5432/linko_board_system
      ADMIN_PASSWORD: ${ADMIN_PASSWORD:-admin123}
      JWT_SECRET: ${JWT_SECRET:-super-secret-key-change-in-production-12345}
      # ローカル LLM（Ollama）。未設定時は自動振り分けはスキップ
      OLLAMA_URL: ${OLLAMA_URL:-http://172.16.1.242:11435/v1}
      # 未設定で自動（Ollama のローカルモデル一覧から解決）。固定したいときだけ指定
      OLLAMA_MODEL: ${OLLAMA_MODEL:-}
      OLLAMA_MODEL_AUTO_CACHE_TTL_SECONDS: ${OLLAMA_MODEL_AUTO_CACHE_TTL_SECONDS:-600}
      # 社内 LLM Docker を3台まで切替: LLM_TARGET=1|2|3 で OLLAMA_URL_n / OLLAMA_MODEL_n を採用（未設定なら上記のみ）
      LLM_TARGET: ${LLM_TARGET:-}
      OLLAMA_URL_1: ${OLLAMA_URL_1:-}
      OLLAMA_URL_2: ${OLLAMA_URL_2:-}
      OLLAMA_URL_3: ${OLLAMA_URL_3:-}
      OLLAMA_MODEL_1: ${OLLAMA_MODEL_1:-}
      OLLAMA_MODEL_2: ${OLLAMA_MODEL_2:-}
      OLLAMA_MODEL_3: ${OLLAMA_MODEL_3:-}
      # ※ Gemini は使用しない（コメントアウト）
      # GEMINI_API_KEY: ${GEMINI_API_KEY}
      # GEMINI_MODEL: ${GEMINI_MODEL:-gemini-2.5-flash}
      # Google カレンダー連携（パーソナル「今日の予定」）。未設定時は連携無効・ボタンで 503
      GOOGLE_CALENDAR_CLIENT_ID: ${GOOGLE_CALENDAR_CLIENT_ID:-}
      GOOGLE_CALENDAR_CLIENT_SECRET: ${GOOGLE_CALENDAR_CLIENT_SECRET:-}
      GOOGLE_CALENDAR_REDIRECT_URI: ${GOOGLE_CALENDAR_REDIRECT_URI:-}
      # --- 追加: OAuth トークン暗号化キー ---
      TOKEN_ENCRYPTION_KEY: ${TOKEN_ENCRYPTION_KEY:-default-insecure-key-32-bytes-long!}
      # ------------------------------------
      # OAuth 成功後のリダイレクト先。Next basePath が /boards のため /boards を指定（未設定時は /boards）
      OAUTH_SUCCESS_REDIRECT_BASE: ${OAUTH_SUCCESS_REDIRECT_BASE:-/boards}
      POSTIT_BOARD_URL: http://sticky-note:3000
      # Nginx経由のリクエストを信頼
      FORWARDED_ALLOW_IPS: "*"
    volumes:
      # デスクトップアプリ配布物 (latest.json / *.msi) を bind mount。
      # これによりホスト側のファイルを差し替えるだけで即配信され、
      # backend イメージの再ビルド (deploy.sh) が不要になる。
      # Dockerfile の COPY . . でイメージにも焼かれるが、mount が上書きするので
      # ホスト側が常に最新として参照される。
      - ./backend/desktop_app_releases:/app/desktop_app_releases
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - linko-net
    restart: always

  frontend:
    build:
      context: ./frontend
      args:
        NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-https://wlboardsys.internal.wonder-link.com/api/bs}
        NEXT_PUBLIC_BASE_PATH: ${NEXT_PUBLIC_BASE_PATH:-/boards}
        NEXT_PUBLIC_LEGACY_BOARD_URL: ${NEXT_PUBLIC_LEGACY_BOARD_URL:-https://wlboardsys.internal.wonder-link.com}
    container_name: linko-frontend-${COLOR}
    ports:
      - "127.0.0.1:${PORT_FRONTEND}:3000"
    environment:
      NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-https://wlboardsys.internal.wonder-link.com/api/bs}
      NEXT_PUBLIC_LEGACY_BOARD_URL: ${NEXT_PUBLIC_LEGACY_BOARD_URL:-https://wlboardsys.internal.wonder-link.com}
    networks:
      - linko-net
    restart: always

  sticky-note:
    build:
      context: ../wl-sticky-note/src
      args:
        NEXT_PUBLIC_STICKY_BASE_PATH: ${NEXT_PUBLIC_STICKY_BASE_PATH:-/board}
    container_name: linko-sticky-note-${COLOR}
    ports:
      - "127.0.0.1:${PORT_STICKY}:3000"
    environment:
      NODE_ENV: production
      PORT: "3000"
      BOARD_SYSTEM_API_URL: ${BOARD_SYSTEM_API_URL:-https://host.docker.internal/api/bs}
      NEXT_PUBLIC_BOARD_SYSTEM_URL: ${NEXT_PUBLIC_BOARD_SYSTEM_URL:-https://wlboardsys.internal.wonder-link.com/boards}
      DATA_DIR: /app/data
    volumes:
      # blue/green で同じボリュームを共有し、デプロイ切り替えで付箋が消えないようにする
      - sticky_data:/app/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - linko-net
    restart: always

networks:
  linko-net:
    external: true

volumes:
  # 付箋データ永続化（blue/green 共通。初回のみ docker volume create sticky_note_data を実行すること）
  sticky_data:
    external: true
    name: sticky_note_data
</file>

<file path="docker-compose.staging.yml">
# ステージング用オーバーライド: 本番と同じ compose だが Backend のみ別 DB を使用
# 使い方: docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml -p board-system-staging up -d --build

services:
  backend:
    environment:
      DATABASE_URL: postgresql+asyncpg://linko_user:linko_password@linko-db:5432/linko_board_system_staging

  sticky-note:
    environment:
      # Docker 内部ネットワーク経由で直接ステージングの backend コンテナに通信（SSLエラー回避）
      BOARD_SYSTEM_API_URL: "http://backend:8000"
</file>

<file path="docker-compose.yml">
# ==========================================================
# Docker Compose - ローカル開発 & 本番共通
# sticky-note + board-system (backend/frontend) + PostgreSQL
# ==========================================================
# 起動: docker compose up -d --build
# 付箋ボードも含める: docker compose --profile sticky up -d --build（要 wl-sticky-note）
# 停止: docker compose down
# ログ: docker compose logs -f
# ==========================================================

services:
  # --- PostgreSQL ---
  db:
    image: postgres:15-alpine
    container_name: linko-db
    ports:
      - "127.0.0.1:5433:5432"
    environment:
      POSTGRES_USER: linko_user
      POSTGRES_PASSWORD: linko_password
      POSTGRES_DB: linko_board_system
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U linko_user -d linko_board_system" ]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  # --- Board System Backend (FastAPI) ---
  backend:
    build: ./backend
    container_name: linko-backend
    ports:
      - "8010:8000"
    environment:
      DATABASE_URL: postgresql+asyncpg://linko_user:linko_password@db:5432/linko_board_system
      ADMIN_PASSWORD: ${ADMIN_PASSWORD:-admin123}
      JWT_SECRET: ${JWT_SECRET:-super-secret-key-change-in-production-12345}
      OLLAMA_URL: ${OLLAMA_URL:-http://172.16.1.242:11435/v1}
      OLLAMA_MODEL: ${OLLAMA_MODEL:-}
      OLLAMA_MODEL_AUTO_CACHE_TTL_SECONDS: ${OLLAMA_MODEL_AUTO_CACHE_TTL_SECONDS:-600}
      LLM_TARGET: ${LLM_TARGET:-}
      OLLAMA_URL_1: ${OLLAMA_URL_1:-}
      OLLAMA_URL_2: ${OLLAMA_URL_2:-}
      OLLAMA_URL_3: ${OLLAMA_URL_3:-}
      OLLAMA_MODEL_1: ${OLLAMA_MODEL_1:-}
      OLLAMA_MODEL_2: ${OLLAMA_MODEL_2:-}
      OLLAMA_MODEL_3: ${OLLAMA_MODEL_3:-}
      GOOGLE_CALENDAR_CLIENT_ID: ${GOOGLE_CALENDAR_CLIENT_ID:-}
      GOOGLE_CALENDAR_CLIENT_SECRET: ${GOOGLE_CALENDAR_CLIENT_SECRET:-}
      GOOGLE_CALENDAR_REDIRECT_URI: ${GOOGLE_CALENDAR_REDIRECT_URI:-}
      OAUTH_SUCCESS_REDIRECT_BASE: ${OAUTH_SUCCESS_REDIRECT_BASE:-}
      POSTIT_BOARD_URL: http://sticky-note:3000
      TOKEN_ENCRYPTION_KEY: ${TOKEN_ENCRYPTION_KEY:-default-insecure-key-32-bytes-long!}
      FORWARDED_ALLOW_IPS: "*"
    volumes:
      - ./backend/desktop_app_releases:/app/desktop_app_releases
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped

  # --- Board System Frontend (Next.js) ---
  frontend:
    build:
      context: ./frontend
      args:
        NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-http://localhost:8010}
        NEXT_PUBLIC_BASE_PATH: ${NEXT_PUBLIC_BASE_PATH:-""}
        NEXT_PUBLIC_LEGACY_BOARD_URL: ${NEXT_PUBLIC_LEGACY_BOARD_URL:-http://localhost:3011}
    container_name: linko-frontend
    ports:
      - "3010:3000"
    environment:
      NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL:-http://localhost:8010}
      NEXT_PUBLIC_LEGACY_BOARD_URL: ${NEXT_PUBLIC_LEGACY_BOARD_URL:-http://localhost:3011}
    depends_on:
      - backend
    restart: unless-stopped

  # --- 付箋ボード (Next.js + Express + Socket.IO) ---
  sticky-note:
    build:
      context: ../wl-sticky-note/src
      args:
        NEXT_PUBLIC_BASE_PATH: ${NEXT_PUBLIC_STICKY_BASE_PATH:-""}
    container_name: linko-sticky-note
    profiles:
      - sticky
    ports:
      - "3011:3000"
    environment:
      NODE_ENV: production
      PORT: "3000"
      BOARD_SYSTEM_API_URL: http://backend:8000
      NEXT_PUBLIC_BOARD_SYSTEM_URL: ${NEXT_PUBLIC_BOARD_SYSTEM_URL:-http://localhost:3010}
      DATA_DIR: /app/data
    volumes:
      - sticky_data:/app/data
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - backend
    restart: unless-stopped

volumes:
  postgres_data:
  sticky_data:
</file>

