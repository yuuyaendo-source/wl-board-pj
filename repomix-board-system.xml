# ローカル LLM（Ollama）。自動仕分け・マトリクススコア・日次リセットに使用。未設定時は AI はスキップ
OLLAMA_URL=http://172.16.1.242:11435/v1
# OLLAMA_MODEL は省略可（自動解決）。固定したいときだけ指定
# OLLAMA_MODEL_AUTO_CACHE_TTL_SECONDS=600
#
# 社内 LLM 用 Docker が複数ある場合: LLM_TARGET=1|2|3 で切替（その番号の URL/モデルを使用）
# 未設定なら従来どおり OLLAMA_URL / OLLAMA_MODEL のみ。
# 各番号の URL が空のときは OLLAMA_URL にフォールバック。モデルが空のときは OLLAMA_MODEL にフォールバック。
# LLM_TARGET=2
# DB の system_settings で上書き可能（API PUT /admin/llm）。未マイグレーション時は env のみ有効。
# OLLAMA_URL_1=http://172.16.1.242:11435/v1
# OLLAMA_MODEL_1=pakachan/elyza-llama3-8b:latest
# OLLAMA_URL_2=http://172.16.1.252:11435/v1
# OLLAMA_MODEL_2=other/model:latest
# OLLAMA_URL_3=http://172.16.1.253:11435/v1
# OLLAMA_MODEL_3=...

# フロントビルド時に埋め込む API・付箋ボード URL（本番では https にすること）
# 未設定時は docker-compose.prod.yml のデフォルト（wlboardsys.internal.wonder-link.com）が使われる
# NEXT_PUBLIC_API_URL=https://wlboardsys.internal.wonder-link.com/api/bs
# NEXT_PUBLIC_LEGACY_BOARD_URL=https://wlboardsys.internal.wonder-link.com
# NEXT_PUBLIC_BASE_PATH=/boards
# NEXT_PUBLIC_STICKY_BASE_PATH=/board
# NEXT_PUBLIC_BOARD_SYSTEM_URL=https://wlboardsys.internal.wonder-link.com/boards

# 任意: ログレベル
# LOG_LEVEL=INFO

# Google カレンダー連携（パーソナルボードの「今日の予定」）。未設定なら連携無効
# Google Cloud Console で OAuth 2.0 クライアント ID（ウェブアプリ）を作成し、リダイレクト URI を登録してから設定
# GOOGLE_CALENDAR_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=xxx
# GOOGLE_CALENDAR_REDIRECT_URI=https://wlboardsys.internal.wonder-link.com/api/bs/auth/google/callback
# CALENDAR_TIMEZONE=Asia/Tokyo
# OAuth 成功後にパーソナルボードへ戻すパス。本番で Next basePath が /boards のときは /boards（未設定時は compose で /boards をデフォルト指定）
# OAUTH_SUCCESS_REDIRECT_BASE=/boards

# 日次スケジュール設定（8:00 run_8am, 10:00 ニュースクリア, 10:15 sync_to_morning + ニュース取得）
# SCHEDULER_ENABLED=true
# SCHEDULER_BASE_URL=http://127.0.0.1:8000

# ※ DB は docker-compose.db.yml で定義。DATABASE_URL は backend コンテナ内で compose が指定するためここでは不要。
# ※ Gemini は使用しない（ローカル LLM 利用のため）。

# OAuth トークン暗号化キー（本番環境では必ず32バイト以上の安全なキーを設定）
# 本番用:
# TOKEN_ENCRYPTION_KEY=s3cr3t-k3y-f0r-3ncrypt1ng-t0k3ns-32-b4yts!
# 開発用（またはテスト時のみ）:
TOKEN_ENCRYPTION_KEY=YourSuperSecretKeyMustBe32Bytes!
</file>

