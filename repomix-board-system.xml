<file path="nginx/nginx.conf">
worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    # アップストリーム定義（deploy.sh によって上書きされる active_env.conf を読み込む）
    # 初期状態では active_env.conf が存在しない場合エラーになるので、
    # 運用開始前に deploy.sh を一度実行するか、手動で作成する必要がある。
    include /etc/nginx/conf.d/active_env.conf;

# 証明書: Let's Encrypt 発行の *.internal.wonder-link.com（fullchain.pem / privkey.pem をこのパスに配置）
# FQDN: https://wlboardsys.internal.wonder-link.com/ （証明書の CN/SAN に合わせること）

    # HTTP → HTTPS リダイレクト
    server {
        listen 80;
        server_name wlboardsys.internal.wonder-link.com 172.16.1.203;
        return 301 https://$host$request_uri;
    }

    # HTTPS（Let's Encrypt *.internal.wonder-link.com を fullchain.pem / privkey.pem で配置）
    server {
        listen 443 ssl;
        server_name wlboardsys.internal.wonder-link.com 172.16.1.203;

        ssl_certificate     /home/hisashi/dev/sv_cert/fullchain.pem;
        ssl_certificate_key /home/hisashi/dev/sv_cert/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

        # ----------------------------------------------------
        # 1. Sticky Note (Express + Socket.IO) へのルーティング
        # ----------------------------------------------------
        
        # Socket.IO (WebSocket)
        location /socket.io/ {
            proxy_pass http://current_sticky;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Sticky Note の画面へのアクセス
        location /board/ {
            proxy_pass http://current_sticky;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Sticky Note API (Board System API との競合回避のため、明示的に指定)
        
        # /api/boards/:id/summary など
        location /api/boards/ {
            proxy_pass http://current_sticky/api/boards/;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # /api/sticky_notes (POST from Python)
        location /api/sticky_notes {
            proxy_pass http://current_sticky/api/sticky_notes;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # /api/health (Sticky Note のヘルスチェック)
        location = /api/health {
            proxy_pass http://current_sticky/api/health;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ----------------------------------------------------
        # 2. Board System Backend (FastAPI) へのルーティング
        # ----------------------------------------------------

        # Frontend から呼び出す際は /api/bs/ プレフィックスを付けるルールとする
        location /api/bs/ {
            proxy_pass http://current_backend/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ----------------------------------------------------
        # 3. Board System Frontend (Next.js) へのルーティング
        # ----------------------------------------------------
        location /boards/ {
            proxy_pass http://current_frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ルートはタスクボードへリダイレクト
        location = / {
            return 302 https://$host/boards/taskboard;
        }

        location / {
            return 302 https://$host/boards/taskboard;
        }
    }
}
</file>

