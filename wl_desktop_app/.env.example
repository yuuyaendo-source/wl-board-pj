# このPCの利用者を識別するID（パーソナルモードの user に使用。未設定時は USERNAME を使用）
# WLINKO_USER_ID=tanaka
# AIボードのベースURL（未設定時は config.json を使用）
# AI_BOARD_URL=http://127.0.0.1:5000/
# 付箋ボードのURL（新付箋お知らせ用）
# 開発（このPC）: http://127.0.0.1:3000/
# 開発（CATO経由・他PCから開発PCへ）: http://172.16.1.251:3000/
# 本番: https://wl-ai-board.internal.wonder-link.com/
# POSTIT_BOARD_URL=http://127.0.0.1:3000/
#
# セキュリティ (security.py): 外向き URL は社内ホストのみ許可。開発で LAN IP を使う場合:
# WLINKO_EXTRA_ALLOWED_HOSTS=172.16.1.251
# WLINKO_ALLOW_PRIVATE_IPS=1
# 緊急時のみ許可リスト無効化: WLINKO_DISABLE_URL_ALLOWLIST=1
# 付箋ボードのボードIDは config.json の postit_board_id（本番: wl）
