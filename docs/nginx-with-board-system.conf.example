# Nginx 設定例: 付箋ボード + Board System を同一ドメインで提供（linko-system と同じ証明書）
# 証明書: Let's Encrypt *.internal.wonder-link.co.jp（ホストの fullchain.pem, privkey.pem）
# FQDN: https://wl-ai-board.internal.wonder-link.co.jp/
# 参照: docs/本番デプロイ手順.md
#
# 他サイト（例: server_name _ の brainstorming）がある場合、付箋ボード用を default_server にすると
# 同じ IP でアクセスしたときにこちらが優先される。

# HTTP → HTTPS リダイレクト
server {
    listen 80 default_server;
    server_name wl-ai-board.internal.wonder-link.co.jp 172.16.1.84;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name wl-ai-board.internal.wonder-link.co.jp 172.16.1.84;

    ssl_certificate     /home/hisashi/dev/sv_cert/fullchain.pem;
    ssl_certificate_key /home/hisashi/dev/sv_cert/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    access_log /var/log/nginx/wl-sticky-note_access.log;
    error_log /var/log/nginx/wl-sticky-note_error.log;
    client_max_body_size 10M;

    # ----- Board System API（/boards-api/ → バックエンド 8000） -----
    location /boards-api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ----- Board System フロント（/boards および /boards/... → Next.js 3001） -----
    # /boards のみのときは /boards/ へリダイレクト（Next の basePath と相性を合わせる）
    location = /boards {
        return 302 $scheme://$host/boards/;
    }
    # Board System フロント（proxy_pass の末尾にパスを付けないこと。付けると /boards/task が 3001 で /task になり RSC が 404 になる）
    location /boards/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # ----- 付箋ボード用 _next（3000 のアセット。Board System は /boards/_next/ を使用） -----
    location /_next/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # ----- 付箋ボード（Next.js + Socket.IO, 3000） -----
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_cache_bypass $http_upgrade;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 7d;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;
    }
}
