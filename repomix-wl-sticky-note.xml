}

.input {
    width: 100%;
    padding: 12px 16px;
    font-size: 16px;
    border: 2px solid #ddd;
    border-radius: 8px;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
}

.input:focus {
    border-color: var(--primary, #79dc89);
}

.error {
    margin-top: 8px;
    color: #d32f2f;
    font-size: 14px;
    text-align: center;
}

.button {
    width: 100%;
    padding: 12px;
    margin-top: 16px;
    background: var(--primary, #79dc89);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.1s, background 0.2s;
}

.button:hover {
    background: #6ac97a;
}

.button:active {
    transform: scale(0.98);
}

.note {
    margin: 16px 0 0 0;
    color: #999;
    font-size: 12px;
    text-align: center;
}
