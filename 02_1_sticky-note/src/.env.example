NODE_ENV=development
PORT=3000

# Board System (4ボード) へのリンク先。未設定時は http://localhost:3001
# NEXT_PUBLIC_BOARD_SYSTEM_URL=http://localhost:3001

# AIボード（02_2）へのリンク先。トップ・ツールバーの「AIボードを開く」用。未設定時は http://localhost:5000
# NEXT_PUBLIC_AI_BOARD_URL=http://localhost:5000

# Board System API（付箋削除連携: 付箋ボードで削除したら Task/Personal からも削除）。未設定時は http://127.0.0.1:8000
# BOARD_SYSTEM_API_URL=http://127.0.0.1:8000

# AI-Board 連携（http://wl-sticky-note.local/board/wl の付箋を AI-Board に送る）
# 同一マシン: http://127.0.0.1:5000  別マシン: AI-Board の URL（例: http://172.16.1.251:5000）
# AI_BOARD_URL=http://127.0.0.1:5000
# 付箋追加時に AI-Board へ通知するボードID（カンマ区切り。本番: wl）
# AI_BOARD_LINK_BOARD_IDS=wl
